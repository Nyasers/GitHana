{
  "name": "githana",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check": "node scripts/build-app.mjs && node scripts/selfcheck.mjs",
    "check:all": "node scripts/build-app.mjs && node scripts/selfcheck.mjs && node scripts/derive/index.mjs --check && node scripts/fetch-vendor.mjs --check",
    "pack": "node scripts/pack.mjs",
    "index": "node scripts/build-index.mjs",
    "vendor": "node scripts/fetch-vendor.mjs",
    "derive": "node scripts/derive/index.mjs",
    "derive:check": "node scripts/derive/index.mjs --check",
    "permission-table": "node scripts/derive/fetch-permission-table.mjs",
    "sync:sdk": "node scripts/sync-sdk.mjs",
    "sync:app-tools": "node scripts/sync-app-tools.mjs",
    "install:local": "node scripts/dev/install-local.mjs",
    "probe:host": "node scripts/probe/host-surface.mjs"
  },
  "devDependencies": {
    "@rspack/core": "^2.2.9",
    "openpgp": "6.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@hana/app-sdk": "file:./vendor/hana-app-sdk/hana-app-sdk.tgz"
  }
}
