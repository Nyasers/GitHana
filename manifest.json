{
  "manifestVersion": 2,
  "id": "githana",
  "name": "GitHana",
  "version": "1.2.0",
  "description": "把 git / gh / gpg 三条 CLI 接进 Hana：仓库状态与提交、GitHub PR、隔离 GPG 签名身份",
  "entry": "bin/app.mjs",
  "icon": "assets/icon.svg",
  "minAppVersion": "1.0.16-beta",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn",
    "app/tasks.manage",
    "app/session.start-turn",
    "app/ui.clipboard-write",
    "app/ui.open-external"
  ],
  "contributes": {
    "settings": {
      "title": "GitHana",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
