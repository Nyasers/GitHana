{
  "manifestVersion": 2,
  "id": "githana",
  "name": "GitHana",
  "version": "1.0.0-rc.1",
  "description": "把 git / gh / gpg 三条 CLI 接进 Hana：仓库状态与提交、GitHub PR、隔离 GPG 签名身份",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "0.970.9",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "settings": {
      "title": "GitHana",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
